APP_NAME="Electricity Distribution Department API"
ENVIRONMENT=development

# Database Connection (Switch between SQLite and PostgreSQL)
# PostgreSQL (Default when using pgAdmin / PostgreSQL Desktop App):
# Replace 'your_password' with your PostgreSQL master password:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/electricity_department
# SQLite fallback:
# DATABASE_URL=sqlite:///./electricity_department.db
# Production: refuse to start unless DATABASE_URL is PostgreSQL.
# REQUIRE_POSTGRES=true

# Samanvay portal's public URL (cloud). Unset locally: the website uses its own
# hostname + the portal port from ports.json.
# PORTAL_URL=https://samanvay-portal-production.up.railway.app
# CORS: comma-separated allowed origins, or * (default)
# CORS_ALLOWED_ORIGINS=https://samanvay-portal-production.up.railway.app

CHAOS_ENABLED=false
APPLICATION_FAILURE_RATE=0.10
VERIFY_FAILURE_RATE=0.10
STATUS_FAILURE_RATE=0.05
SCHEMA_DRIFT_RATE=0.20
SIMULATED_DELAY_RATE=0.05
SIMULATED_DELAY_MS=3000
